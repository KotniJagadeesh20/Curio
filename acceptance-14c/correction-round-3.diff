+    rerender({ k: "A", p: q({}) });                               // visit 3 (A): request 2
+    expect(reqs).toHaveLength(3);
+    await act(async () => { reqs[0].resolve(); });               // visit 1's A request completes now
+    rerender({ k: "A", p: q({ data: "old A" }) });
