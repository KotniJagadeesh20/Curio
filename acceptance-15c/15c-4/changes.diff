+    fireEvent.click(screen.getByRole("button", { name: "Try again" }));
+    await loaded();
+    expect(api.sent("GET", "/users/me")).toHaveLength(before + 1);
+  });
+
+  it("12: sets the document title", async () => {
+    renderPage();
+    await loaded();
+    expect(document.title).toBe("Profile settings · AlgoQuest");
+  });
+});
